{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mango-style-library.local/schemas/asset-manifest.schema.json",
  "title": "Tingen Pixel Asset Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "asset_id", "asset_name", "profile_id", "style_version", "asset_class",
    "district_id", "dimensions", "facing", "anchor", "anchor_coordinate_kind",
    "material_ids", "palette_version", "palette_approval_status", "alpha_policy",
    "source_status", "sha256", "lifecycle_status"
  ],
  "properties": {
    "asset_id": {"type": "string", "minLength": 1},
    "asset_name": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "profile_id": {"const": "tingen_pixel_v3_hd"},
    "style_version": {"const": "tingen_pixel_v3_hd"},
    "asset_class": {
      "enum": ["terrain_tile", "material_review_sample", "character_frame", "facade_component", "building_composite", "landmark_composite", "municipal_hall_tingen", "ui", "vfx", "prop"]
    },
    "district_id": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}]
    },
    "facing": {"enum": ["south", "west", "east", "north", "not_applicable"]},
    "anchor": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{"type": "integer"}, {"type": "integer"}]
    },
    "anchor_coordinate_kind": {"const": "canvas_boundary"},
    "material_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "palette_version": {"const": "tingen_pixel_v3_hd"},
    "palette_approval_status": {"type": "string"},
    "alpha_policy": {"const": "hard_0_255"},
    "source_status": {
      "enum": ["original_or_authorized", "pixel_redraw_from_authorized_reference", "pixel_redraw_from_generated_reference"]
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lifecycle_status": {
      "enum": ["candidate_pending_user_1x_review", "approved_1x", "runtime_validation_pending", "runtime_ready", "rejected"]
    }
  }
}
